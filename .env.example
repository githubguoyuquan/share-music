# Local Node only — Postgres runs wherever DATABASE_URL points (推荐云端托管库).

# Copy to `.env.local`:
#   cp .env.example .env.local

# 示例：Neon / Supabase / RDS / Fly.io Postgres 等给的连接串
DATABASE_URL="postgresql://USER:PASSWORD@HOSTNAME:5432/DATABASE_NAME"

# JWT（开发可先用任意字符串，上线务必换成长随机）
JWT_SECRET="dev-change-me"
