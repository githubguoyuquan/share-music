# Copy to `.env` in this directory so Docker Compose can substitute variables:
#   cp docker.env.example .env
# Edit JWT_SECRET to a long random string before production.

# 在本机执行 `npm run seed` / Prisma 时也需要 DATABASE_URL（与 compose 里库密码一致）:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/music_share

JWT_SECRET=
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=3000
